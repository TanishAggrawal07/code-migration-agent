# ── Provider selection ────────────────────────────────────────────────────
# "auto" tries Ollama first, then Gemini, OpenRouter, Grok, OpenAI in order.
# Set to "ollama", "gemini", "openrouter", "grok", or "openai" to force one.
AI_PROVIDER=auto

# ── Ollama (local — highest priority in auto mode) ────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Leave blank to auto-select the highest-priority installed coding model.
OLLAMA_MODEL=
# Comma-separated preference list used when OLLAMA_MODEL is not set.
OLLAMA_MODEL_PRIORITY=qwen2.5-coder,deepseek-coder,kimi-k2,gemma3,llama3

# ── Gemini ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=3

# ── OpenRouter ────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Grok (xAI) ───────────────────────────────────────────────────────────
GROK_API_KEY=
GROK_MODEL=grok-2-1212

# ── OpenAI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Embeddings ────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# ── Vector store ──────────────────────────────────────────────────────────
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=migration_docs

# ── File storage ──────────────────────────────────────────────────────────
STORAGE_ROOT=./storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_UPLOAD_SIZE_MB=100
MAX_FILE_SIZE_MB=20
MAX_REQUEST_SIZE_MB=200

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ── Application ───────────────────────────────────────────────────────────
APP_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000
